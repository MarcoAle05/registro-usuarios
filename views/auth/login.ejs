<%- include('../plantillas/header', { titulo: 'Iniciar sesión', ancho: 'estrecho' }) %>
  <h1>Iniciar sesión</h1>
  <p class="texto-suave mb-4">Entra para consultar y administrar el registro de personas.</p>

  <% if (error) { %><div class="alert alert-danger" role="alert" tabindex="-1" data-enfocar><%= error %></div><% } %>

  <form action="/login" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label class="form-label" for="email">Correo electrónico</label>
    <input class="form-control mb-3" id="email" type="email" name="email" autocomplete="email" required value="<%= email %>">

    <label class="form-label" for="password">Contraseña</label>
    <div class="input-group mb-4">
      <input class="form-control" id="password" type="password" name="password" autocomplete="current-password" required>
      <button class="btn btn-outline-secondary" type="button" data-mostrar-password="password" aria-pressed="false">Mostrar</button>
    </div>

    <button class="btn btn-primary w-100" type="submit">Iniciar sesión</button>
  </form>

  <p class="enlaces-formulario">¿No tienes cuenta? <a href="/registro">Crea una</a></p>
<%- include('../plantillas/footer') %>
