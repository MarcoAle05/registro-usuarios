<%- include('../plantillas/header') %>
  <h1>Iniciar sesión</h1>

  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <form class="text-start mx-auto" style="max-width: 480px" action="/login" method="POST">
    <input class="form-control mb-2" type="email"    name="email"    placeholder="Email"      required value="<%= email %>">
    <input class="form-control mb-2" type="password" name="password" placeholder="Contraseña" required>
    <button class="btn btn-primary w-100" type="submit">Entrar</button>
  </form>

  <p class="mt-3">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
<%- include('../plantillas/footer') %>
