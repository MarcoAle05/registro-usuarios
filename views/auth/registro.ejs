<%- include('../plantillas/header', { titulo: 'Crear cuenta', ancho: 'estrecho' }) %>
  <h1>Crear cuenta</h1>
  <p class="texto-suave mb-4">Con tu cuenta podrás consultar el registro de personas y editar tus propios datos.</p>

  <% if (error) { %>
    <div class="alert alert-danger" role="alert" tabindex="-1" data-enfocar><%= error %>
      <% if (yaRegistrado) { %> <a href="/login">Inicia sesión aquí</a><% } %>
    </div>
  <% } %>

  <form action="/registro" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="row g-3 mb-3">
      <div class="col-sm-6">
        <label class="form-label" for="nombre">Nombre</label>
        <input class="form-control" id="nombre" type="text" name="nombre" autocomplete="given-name" required value="<%= valores.nombre || '' %>">
      </div>
      <div class="col-sm-6">
        <label class="form-label" for="apellido">Apellido</label>
        <input class="form-control" id="apellido" type="text" name="apellido" autocomplete="family-name" required value="<%= valores.apellido || '' %>">
      </div>
    </div>

    <label class="form-label" for="email">Correo electrónico</label>
    <input class="form-control mb-3" id="email" type="email" name="email" autocomplete="email" required value="<%= valores.email || '' %>">

    <label class="form-label" for="edad">Edad</label>
    <input class="form-control mb-1" id="edad" type="number" name="edad" min="0" max="120" inputmode="numeric" aria-describedby="ayuda-edad" required value="<%= valores.edad || '' %>">
    <div class="form-text mb-3" id="ayuda-edad">Un número entre 0 y 120.</div>

    <label class="form-label" for="password">Contraseña</label>
    <div class="input-group mb-1">
      <input class="form-control" id="password" type="password" name="password" minlength="6" autocomplete="new-password" aria-describedby="ayuda-password" required>
      <button class="btn btn-outline-secondary" type="button" data-mostrar-password="password" aria-pressed="false">Mostrar</button>
    </div>
    <div class="form-text mb-4" id="ayuda-password">Mínimo 6 caracteres.</div>

    <button class="btn btn-primary w-100" type="submit">Crear cuenta</button>
  </form>

  <p class="enlaces-formulario">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
<%- include('../plantillas/footer') %>
