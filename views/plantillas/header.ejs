<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== 'undefined' && titulo ? titulo + ' · ' : '' %>Lonja de Veracruz</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/bootstrap/css/estilos.css">
</head>
<body>
  <a class="saltar" href="#main">Saltar al contenido</a>
  <nav class="navbar navbar-expand-lg bg-body-tertiary" aria-label="Principal">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">LONJA DE VERACRUZ</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
              aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar u ocultar el menú">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menuPrincipal">
        <% if (sesion) { %>
        <%
          const activo = (...rutas) => rutas.some((r) => (r === '/' ? rutaActual === '/' : rutaActual.startsWith(r)));
          const enlace = (href, texto) => `<a class="nav-link${activo(href) ? ' active' : ''}" href="${href}"${activo(href) ? ' aria-current="page"' : ''}>${texto}</a>`;
        %>
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><%- enlace('/', 'Inicio') %></li>
          <li class="nav-item"><%- enlace('/compras', 'Compras') %></li>
          <li class="nav-item"><%- enlace('/lotes', 'Lotes') %></li>
          <li class="nav-item"><%- enlace('/reporte', 'Reporte diario') %></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle<%= activo('/especies', '/tipos', '/compradores') ? ' active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Catálogos</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/especies">Especies</a></li>
              <li><a class="dropdown-item" href="/tipos">Tipos</a></li>
              <li><a class="dropdown-item" href="/compradores">Compradores</a></li>
            </ul>
          </li>
          <li class="nav-item"><%- enlace('/usuarios', sesion.rol === 'admin' ? 'Usuarios' : 'Mi cuenta') %></li>
        </ul>
        <% } else { %>
        <ul class="navbar-nav me-auto mb-2 mb-lg-0"></ul>
        <% } %>
        <ul class="navbar-nav align-items-lg-center gap-lg-2 mb-2 mb-lg-0">
          <% if (sesion) { %>
            <li class="nav-item"><span class="navbar-text">Hola, <%= sesion.nombre %></span></li>
            <li class="nav-item">
              <form action="/logout" method="POST" class="m-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-outline-secondary btn-sm" type="submit">Cerrar sesión</button>
              </form>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="btn btn-primary btn-sm" href="/login">Iniciar sesión</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
  <main id="main" class="container text-center shadow-lg p-3 mb-5 bg-body-tertiary rounded" tabindex="-1">
    <div class="<%= typeof ancho !== 'undefined' && ancho ? 'panel--' + ancho + ' text-start' : '' %>">
      <% if (flash && flash.mensaje) { %><div class="alert alert-success" role="status" tabindex="-1" data-enfocar><%= flash.mensaje %></div><% } %>
      <% if (flash && flash.info) { %><div class="alert alert-info" role="status" tabindex="-1" data-enfocar><%= flash.info %></div><% } %>
      <% if (flash && flash.error) { %><div class="alert alert-danger" role="alert" tabindex="-1" data-enfocar><%= flash.error %></div><% } %>
